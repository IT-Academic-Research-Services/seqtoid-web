<%#
  SMP-1851 — CZID-330 export-control / Terms-of-Use attestation click-through.

  Dependency-free (no React/webpack entry): the page renders inside the SPA shell (blank navy header + white
  SeqtoID logo) but the content is plain ERB, so the gate works even if JS fails. Styling comes from the
  shared, brand-tokened partial (export_control/_styles).

  ⚠️ Do NOT change the two submit buttons' `name`/`value`. The server compares params[:decision] for EXACT
  equality with ExportControlAttestation::DECISION_ACCEPTED ("accepted"); any other value — including a
  casing change — silently coerces to "declined" and routes the user to the 403 deny page.

  When the attestation copy changes, bump ExportControlAttestation::CURRENT_VERSION in lockstep so users
  re-attest.
%>
<%= render "export_control/styles" %>
<main class="ec-page">
  <div class="ec-card">
    <h1 class="ec-h1">
      Export-control acknowledgement required
    </h1>

    <div class="ec-panel">
      <p>
        Access to this service is subject to U.S. export-control laws. By continuing, you attest that you
        are not located in, ordinarily resident in, or accessing this service on behalf of any individual
        or entity in a jurisdiction subject to U.S. export-control restrictions, and that you are not a
        restricted or denied party under applicable law.
      </p>
    </div>

    <%= form_with url: export_control_attestations_path, method: :post, local: true do %>
      <%# The version the user is agreeing to is recorded server-side; surfaced here for the record. %>
      <p class="ec-meta">Attestation version: <%= @attestation_version %></p>

      <div class="ec-actions">
        <%# ACCEPT — value MUST stay ExportControlAttestation::DECISION_ACCEPTED ("accepted") verbatim. %>
        <button type="submit" name="decision" value="<%= ExportControlAttestation::DECISION_ACCEPTED %>"
                class="ec-btn ec-btn--primary">
          I attest and agree — continue
        </button>

        <%# DECLINE — records "declined" and routes to the deny page. %>
        <button type="submit" name="decision" value="<%= ExportControlAttestation::DECISION_DECLINED %>"
                class="ec-btn ec-btn--danger">
          I do not agree
        </button>
      </div>
    <% end %>
  </div>
</main>
