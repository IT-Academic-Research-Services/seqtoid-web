<%= javascript_tag do %>
  react_component('DiscoveryViewRouter', {
    domain: "my_data",
    admin: <%= current_user ? current_user.admin : "null" %>,
    projectId: <%= raw escape_json(@project_id&.to_s) %>,
    mapTilerKey: <%= raw escape_json(ENV["MAPTILER_API_KEY"].to_s.strip) %>,
    mapStyleId: <%= raw escape_json(ENV["MAP_STYLE_ID"].to_s.strip) %>,
  }, 'page_content', JSON.parse('<%= raw escape_json(user_context)%>'));
<% end %>
